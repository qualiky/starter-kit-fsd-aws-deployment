# Copy this file to .env and fill in your values

# MySQL RDS connection string
# Format: mysql+pymysql://user:password@rds-endpoint:3306/dbname
DATABASE_URL=mysql+pymysql://appuser:yourpassword@your-rds-endpoint.us-east-1.rds.amazonaws.com:3306/appdb

# S3 bucket name (must be public-read or use pre-signed URLs)
S3_BUCKET_NAME=your-s3-bucket-name

# AWS region where RDS and S3 live
AWS_REGION=us-east-1

# Strong random secret for JWT signing (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-strong-random-secret
